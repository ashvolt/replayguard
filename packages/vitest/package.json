{
	"name": "@replayguard/vitest",
	"version": "0.0.0",
	"description": "Vitest matchers for ReplayGuard side-effect assertions.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ashvolt/replayguard.git",
		"directory": "packages/vitest"
	},
	"homepage": "https://github.com/ashvolt/replayguard#readme",
	"bugs": "https://github.com/ashvolt/replayguard/issues",
	"keywords": [
		"rivet",
		"workflows",
		"durable-execution",
		"side-effects",
		"idempotency",
		"testing",
		"fault-injection"
	],
	"sideEffects": [
		"./dist/setup.js",
		"./dist/setup.cjs"
	],
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./setup": {
			"import": {
				"types": "./dist/setup.d.ts",
				"default": "./dist/setup.js"
			},
			"require": {
				"types": "./dist/setup.d.cts",
				"default": "./dist/setup.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"test": "vitest run --coverage",
		"mutation": "stryker run"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"dependencies": {
		"@replayguard/core": "workspace:*"
	},
	"peerDependencies": {
		"vitest": ">=3.2 <5"
	},
	"devDependencies": {
		"@replayguard-tools/config": "workspace:*",
		"vitest": "4.1.12"
	}
}
