{
	"name": "@replayguard/fakes",
	"version": "0.0.0",
	"description": "Fake payment, email, HTTP and webhook services that record side effects for ReplayGuard.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ashvolt/replayguard.git",
		"directory": "packages/fakes"
	},
	"homepage": "https://github.com/ashvolt/replayguard#readme",
	"bugs": "https://github.com/ashvolt/replayguard/issues",
	"keywords": [
		"rivet",
		"workflows",
		"durable-execution",
		"side-effects",
		"idempotency",
		"testing",
		"fault-injection"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"test": "vitest run --coverage",
		"mutation": "stryker run"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"dependencies": {
		"@replayguard/core": "workspace:*"
	},
	"devDependencies": {
		"@replayguard-tools/config": "workspace:*"
	}
}
