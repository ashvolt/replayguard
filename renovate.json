{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
	"minimumReleaseAge": "7 days",
	"internalChecksFilter": "strict",
	"rangeStrategy": "auto",
	"labels": ["dependencies"],
	"packageRules": [
		{
			"description": "Group dev tooling updates",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "dev tooling"
		},
		{
			"description": "Rivet peer/dev versions move together and run the compatibility matrix",
			"matchPackageNames": ["@rivet-dev/workflows", "rivetkit"],
			"groupName": "rivet"
		},
		{
			"description": "GitHub Actions digests",
			"matchManagers": ["github-actions"],
			"groupName": "github actions"
		}
	],
	"lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] }
}
